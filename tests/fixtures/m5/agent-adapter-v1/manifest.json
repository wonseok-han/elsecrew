{
  "schemaVersion": 1,
  "protocolVersion": 1,
  "contract": {
    "capabilities": [
      "system.status", "app.prepareQuit", "project.open", "project.getTree", "project.createWorktree",
      "project.close", "file.read", "file.save", "file.watch", "diff.getSummary", "diff.getFile",
      "workspace.getTree", "workspace.close", "workspace.file.read", "workspace.file.save", "workspace.file.watch",
      "workspace.diff.getSummary", "workspace.diff.getFile", "workspace.prepareChat", "workspace.abandonPrepared",
      "project.getRoleSettings", "project.updateRoleSettings", "chat.create", "chat.list", "chat.get",
      "run.startFixture", "run.cancel", "recovery.list", "recovery.inspect", "recovery.markResolved",
      "agent.getCapabilities", "run.startAgent", "run.cancelAgent", "recovery.inspectAgent", "recovery.resolveAgent"
    ],
    "bridgeMethodsAdded": ["getAgentCapabilities", "startAgentRun", "cancelAgentRun", "inspectAgentRecovery", "resolveAgentRecovery", "onAgentPublicEvent"],
    "g5bBridgeMethodsAdded": ["onAgentRunStateChanged"],
    "actualAgentAdvertisedByCurrentG5": false,
    "agentSmokeAdvertised": false,
    "fixtureRunSemantics": "fakeOnly",
    "actualRunPersistence": "separateAgentRunsLedger",
    "executionMode": "oneShot",
    "followUpMode": "nextRun",
    "rendererLaunchFields": "forbidden",
    "fingerprint": {
      "algorithm": "sha256",
      "encoding": "utf8CompactJson",
      "objectKeys": "recursiveAsciiAscending",
      "arrayOrder": "preserved",
      "explicitNull": "included",
      "excludedFields": ["fingerprint", "observedAt"],
      "canonicalFixture": "claude-exact-version-measured-capability",
      "canonicalDigest": "sha256:93058dadc9163dcfbf9b8019ad1d980f017624e7c149b5f020085d2b22795fa3"
    },
    "actualRunIdNamespace": "agent_run_",
    "actualRecoveryIdNamespace": "agent_recovery_",
    "actualEventIdNamespace": "agent_event_",
    "agentStateEventIdNamespace": "agent_state_event_",
    "modelStartEvidence": ["runtimeVerified", "measuredExactVersion"],
    "startOutcomes": [
      "started", "platformUnsupported", "notInstalled", "installationIncomplete", "unsupportedVersion",
      "notAuthenticated", "authExpired", "capabilityUnknown", "exactModelUnavailable",
      "reasoningUnsupported", "permissionUnsupported", "profileChanged", "profileUnavailable",
      "workspaceAbandoned", "recoveryBlocked", "chatStateBlocked", "runActive", "writerLocked"
    ],
    "capabilityBlockReasons": [
      "platformUnsupported", "notInstalled", "installationIncomplete", "unsupportedVersion",
      "notAuthenticated", "authExpired", "capabilityUnknown", "exactModelUnavailable"
    ],
    "argvOnlyCanStart": false,
    "publicEvents": ["status", "question", "final"],
    "publicEventProtocolEvent": "agent.publicEvent",
    "publicEventEnvelopeBindingFields": ["chatId", "taskId", "runId"],
    "acceptedBindingFields": ["chatId", "taskId", "projectId", "worktreeId", "workspaceIdentity", "roleId", "capabilityFingerprint"],
    "publicEventBindingFields": ["chatId", "taskId", "projectId", "worktreeId", "workspaceIdentity", "runId", "roleId", "capabilityFingerprint"],
    "runStateProtocolEvent": "agent.runStateChanged",
    "runStatePayloadFields": ["schemaVersion", "eventId", "run"],
    "runStateWireStates": ["running", "succeeded", "failed", "canceled", "recoveryRequired"],
    "runStateEnvelopeBindingFields": ["chatId", "taskId", "runId"],
    "runStateAcceptedBindingFields": ["chatId", "taskId", "projectId", "worktreeId", "workspaceIdentity", "runId", "roleId", "capabilityFingerprint"],
    "runStateStreamSemantics": "sameExclusivePerRunStreamAsAgentPublicEvent",
    "rendererRunStateSemantics": "hydrationTriggerOnly",
    "resourceLimits": {
      "publicEventsPerRun": 256,
      "publicTextBytesPerRun": 1048576,
      "immutablePublicLedgerCumulativeSnapshotBytesPerRun": 16777216,
      "activeActualRunsPerSession": 32,
      "seenActualRunIdsPerSession": 1024,
      "seenActualEventIdsPerSession": 8192,
      "actualStreamIdsPerSession": 1024,
      "protocolStreamIdsPerSession": 4096,
      "publicTextBytesDefinition": "sumUtf8BytesOfAgentPublicEventTextPerRun",
      "immutablePublicLedgerCumulativeSnapshotBytesDefinition": "sumAfterEachAppendUtf8BytesOfRecursiveAsciiKeySortedCompactJsonFullPublicEventsArraySnapshotsPerRun;arrayOrderPreserved;explicitNullIncluded",
      "publicLedgerAmplificationGoldenFile": "g5b-public-ledger-amplification.json"
    },
    "chatDetailCapabilityDiscriminator": "agentRunsPresence",
    "identitylessRecovery": {
      "reason": "processIdentityUnavailable",
      "trackedProcesses": "mustBeEmpty",
      "state": "unresolved",
      "poisoned": true,
      "resolvedAt": null,
      "matchingRevisionOutcome": "identityUnavailable",
      "staleRevisionOutcome": "revisionConflict",
      "after": null,
      "resolutionPriority": ["revisionConflict", "identityUnavailable", "processesRemain", "resolvedAbandoned"]
    },
    "preflightFailure": {"spawnCount": 0, "lockCount": 0},
    "launcherBarrier": ["persistRunAndLock", "captureLauncherAndAgentIdentity", "attachTreeTracker", "persistIdentity", "release"],
    "uncertainTermination": "recoveryRequiredAndPoisoned"
  },
  "casesFile": "cases.json",
  "g5bCasesFile": "g5b-terminal-budget-cases.json",
  "g5cCasesFile": "g5c-provider-attestation-cases.json",
  "g5cRecoveryDiscoveryCasesFile": "g5c-recovery-discovery-cases.json",
  "g5cIdentitylessRecoveryCasesFile": "g5c-identityless-recovery-cases.json"
}
