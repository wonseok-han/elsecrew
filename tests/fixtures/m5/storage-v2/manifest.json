      "sourceLedgerMutationAtomicRollbackRequired": true,
      "compactionTriggerChangeAtomicRollbackRequired": true
    },
    "logicalDeleteBeforeVerification": false,
    "vacuumIsLogicalSuccessCriterion": false,
    "physicalCleanupEnabled": false,
    "cleanupCandidateApiEnabled": false,
    "cleanupActionApiEnabled": false,
    "operationReceiptsImmutable": true,
