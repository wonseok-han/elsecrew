{
  "name": "hello-agent",
  "private": true,
  "version": "0.1.2",
  "type": "module",
  "main": ".vite/build/main.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "node --test --experimental-strip-types tests/*.test.mts",
    "test:harness": "node scripts/m5-harness.mjs --gate baseline",
    "test:m5": "node scripts/m5-harness.mjs --gate g6-release",
    "harness:list": "node scripts/m5-harness.mjs --list",
    "tauri": "tauri",
    "m5:dev": "electron-forge start",
    "m5:package": "electron-forge package",
    "m5:package:smoke": "pnpm run m5:package && node scripts/m5-electron-package-smoke.mjs",
    "m5:make": "electron-forge make",
    "m5:test:electron": "node --test --experimental-strip-types tests/m5-electron*.test.mts && pnpm run m5:package:smoke",
    "m5:test:core": "cargo test --workspace --manifest-path Cargo.toml",
    "m5:test:contracts": "node --test --experimental-strip-types tests/m5-protocol-contract.test.mts && cargo test -p hello-agent-protocol",
    "m5:test:storage": "node --test --experimental-strip-types tests/m5-g3-contract.test.mts tests/m5-electron-bridge.test.mts && cargo test -p hello-agent-sidecar --locked",
    "m5:test:editor": "vite build --config electron/vite.renderer.config.ts && node --test --experimental-strip-types tests/m5-editor-state.test.mts tests/m5-renderer-mount-smoke.test.mts"
  },
  "config": {
    "forge": "./electron/forge.config.ts"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2.7.2",
    "@tauri-apps/plugin-opener": "^2",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-store": "^2.4.4",
    "@tauri-apps/plugin-updater": "^2.10.1",
    "monaco-editor": "0.52.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "6.1.0",
    "@electron-forge/cli": "8.0.0-alpha.10",
    "@electron-forge/maker-zip": "8.0.0-alpha.10",
    "@electron-forge/plugin-fuses": "8.0.0-alpha.10",
    "@electron-forge/plugin-vite": "8.0.0-alpha.10",
    "@electron/fuses": "2.1.3",
    "@electron/asar": "4.3.0",
    "electron": "43.4.0",
    "typescript": "~5.8.3",
    "vite": "8.2.2"
  }
}
